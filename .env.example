# ── Database (Postgres / Supabase) ──────────────────────────────
# Local dev: a Postgres with the PGroonga extension available.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/team_kms
# Optional: dedicated connection for Postgres LISTEN (document_changes).
# Hosted Supabase: point DATABASE_URL at the transaction pooler for queries and
# this at the session pooler / direct connection (transaction pooler drops LISTEN).
# Unset = LISTEN reuses DATABASE_URL (correct for local / direct connections).
DATABASE_LISTEN_URL=

# ── Supabase Auth (JWT verification) ────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── S3 (binary asset storage) ───────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=team-kms-assets
# Optional custom endpoint (e.g. Supabase Storage S3 / MinIO)
S3_ENDPOINT=

# ── Converter service ───────────────────────────────────────────
CONVERTER_URL=http://localhost:8002
# Shared bearer secret between api and converter (generate a random string)
CONVERTER_SECRET=
# LibreOffice binary for Office→PDF. macOS install = "soffice"; Docker = "libreoffice".
LIBREOFFICE_BIN=soffice
# PDF embedded-image extraction caps (optional). Oversized / over-count images
# are skipped with a warning rather than silently truncated.
MAX_IMAGE_BYTES=8388608
MAX_IMAGES_PER_PAGE=30

# ── Image OCR (optional; ingest layer only — backend stays zero-LLM if unset) ──
# Provider for OCRing extracted/uploaded images (tables, flowcharts, figures).
# One of: none | mistral | gemini. Unset/none = no OCR (images still stored).
OCR_PROVIDER=none
MISTRAL_API_KEY=
GEMINI_API_KEY=
# Optional Gemini model override (default: gemini-2.0-flash)
GEMINI_MODEL=

# ── Web (Next.js, NEXT_PUBLIC_* are inlined at build) ───────────
# Put these in apps/web/.env.local for the web app.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Cloud deploy credentials (project-scoped; NEVER user-level OAuth) ──
# GCP: a Service Account key file under ./.gcloud/ (gitignored). Avoids clobbering
# other repos' `gcloud auth login`. Alternatively export CLOUDSDK_CONFIG=./.gcloud
GOOGLE_APPLICATION_CREDENTIALS=./.gcloud/sa-key.json
CLOUDSDK_CORE_PROJECT=your-gcp-project-id
# Supabase: personal access token for CLI ops; pair with `supabase link --project-ref`
SUPABASE_ACCESS_TOKEN=

# ── Service URLs / ports ────────────────────────────────────────
# Cloud Run injects PORT; services honor it over the *_PORT vars below.
API_URL=http://localhost:8000
MCP_URL=http://localhost:8001
APP_URL=http://localhost:3000
API_PORT=8000
MCP_PORT=8001
CONVERTER_PORT=8002
