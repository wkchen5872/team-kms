# ═══════════════════════════════════════════════════════════════════════════
#  ENV FILE MAP — which file owns what (see openspec change env-config-cleanup)
# ═══════════════════════════════════════════════════════════════════════════
#
#   .env                → section A (CLI/deploy creds) + section B-local
#                         (backend LOCAL runtime). Loaded by api/mcp/converter
#                         via `tsx --env-file` and by the guarded scripts.
#   .env.cloud          → section B-cloud (backend CLOUD runtime). Fed to
#                         `gcloud run deploy --set-env-vars`. No local process
#                         reads it. No creds, no NEXT_PUBLIC_*.
#   apps/web/.env.local → section C (web LOCAL NEXT_PUBLIC_*). Next.js reads it.
#   web CLOUD NEXT_PUBLIC_* → passed as `--build-arg` at deploy (no file).
#
#  Readiness markers below:
#   [fill-me]       value exists — enter it
#   [deploy-output] cannot be filled until a prior service is deployed
#   [optional]      leave blank unless the feature is used
# ═══════════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────────
#  A. CLI / DEPLOY CREDENTIALS   → .env   (environment-agnostic; one copy)
#  Operate the cloud from your laptop. NOT service runtime — never goes to
#  Cloud Run. Same values whether you target local or cloud.
# ───────────────────────────────────────────────────────────────────────────
# GCP Service Account key under ./.gcloud/ (gitignored). Avoids clobbering other
# repos' `gcloud auth login`. Alternatively export CLOUDSDK_CONFIG=./.gcloud
GOOGLE_APPLICATION_CREDENTIALS=./.gcloud/sa-key.json
CLOUDSDK_CORE_PROJECT=your-gcp-project-id
# Supabase personal access token for CLI ops; pair with `supabase link --project-ref`
SUPABASE_ACCESS_TOKEN=
# Hosted DB password (for supabase link / migrate scripts; optional = prompt)
SUPABASE_DB_PASSWORD=


# ───────────────────────────────────────────────────────────────────────────
#  B-local. BACKEND LOCAL RUNTIME   → .env   (values point at local Supabase)
# ───────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/team_kms
# LISTEN connection. Unset = reuse DATABASE_URL (correct locally / direct conns).
DATABASE_LISTEN_URL=
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=                       # [fill-me] `supabase status` → anon key
SUPABASE_SERVICE_ROLE_KEY=               # [fill-me] `supabase status` → service_role
AWS_REGION=local
AWS_ACCESS_KEY_ID=                       # [fill-me] `supabase status` → S3 access key
AWS_SECRET_ACCESS_KEY=                   # [fill-me] `supabase status` → S3 secret
S3_BUCKET=team-kms-assets
S3_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
CONVERTER_URL=http://localhost:8002
CONVERTER_SECRET=                        # [fill-me] any random string (api==converter)
LIBREOFFICE_BIN=soffice                  # macOS = soffice; container = libreoffice
MAX_IMAGE_BYTES=8388608
MAX_IMAGES_PER_PAGE=30
# Image OCR (ingest only; backend stays zero-LLM if unset). none | mistral | gemini
OCR_PROVIDER=none
MISTRAL_API_KEY=                         # [optional] only if OCR_PROVIDER=mistral
GEMINI_API_KEY=                          # [optional] only if OCR_PROVIDER=gemini
GEMINI_MODEL=                            # [optional] default gemini-2.0-flash
# App URL — CORS origin (api) + wiki link base (mcp). Ports default to these if unset.
APP_URL=http://localhost:3000
API_PORT=8000
MCP_PORT=8001
CONVERTER_PORT=8002


# ───────────────────────────────────────────────────────────────────────────
#  B-cloud. BACKEND CLOUD RUNTIME   → .env.cloud   (values target hosted project)
#  Fed to `gcloud run deploy --set-env-vars`. Same keys as B-local, cloud values.
#  NO *_PORT (Cloud Run injects PORT). NO API_URL/MCP_URL/APP_URL (deploy outputs).
# ───────────────────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres  # transaction pooler
# DATABASE_LISTEN_URL=postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres  # [fill-me] session pooler (LISTEN)
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_ANON_KEY=                     # [fill-me] Dashboard → Settings → API
# SUPABASE_SERVICE_ROLE_KEY=             # [fill-me] Dashboard → Settings → API
# AWS_REGION=<project region>            # [fill-me] e.g. ap-northeast-2
# AWS_ACCESS_KEY_ID=                     # [fill-me] hosted S3 access key
# AWS_SECRET_ACCESS_KEY=                 # [fill-me] hosted S3 secret
# S3_BUCKET=team-kms-assets
# S3_ENDPOINT=https://<ref>.supabase.co/storage/v1/s3
# CONVERTER_URL=                         # [deploy-output] converter's Cloud Run URL
# CONVERTER_SECRET=                      # [fill-me] same random string as api
# LIBREOFFICE_BIN=libreoffice            # container binary (not macOS soffice)
# OCR_PROVIDER / GEMINI_* / MAX_IMAGE_* : same as B-local


# ───────────────────────────────────────────────────────────────────────────
#  C. WEB NEXT_PUBLIC_*   (inlined at build)
#     local → apps/web/.env.local   |   cloud → gcloud --build-arg
# ───────────────────────────────────────────────────────────────────────────
# apps/web/.env.local (local values):
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<local anon key>
#   NEXT_PUBLIC_API_URL=http://localhost:8000
#
# cloud (--build-arg at web deploy):
#   NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<hosted anon key>
#   NEXT_PUBLIC_API_URL=<api Cloud Run URL>   # [deploy-output]
